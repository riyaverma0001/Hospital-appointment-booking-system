<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Available Dates</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 font-sans text-gray-800">
    <div class="min-h-screen relative flex items-center justify-center">
        <!-- Go to Home Page Button on Top-Right -->
        <div class="absolute top-6 right-6">
            <a href="/" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors">
                Go to Home Page
            </a>
        </div>

        <div class="max-w-3xl w-full p-8 bg-white shadow-xl rounded-xl mt-10 border-t-4 border-green-600">
            <h1 class="text-5xl font-semibold text-center text-green-700 mb-8">Available Dates</h1>

            <% if (success) { %>
                <div class="mb-6">
                    <p class="text-green-600 text-lg mb-4 text-center"><%= message %></p>

                    <!-- Display Available Dates -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                        <% for (let key in available_dates) { %>
                            <a href="/available-slots<%= userId ? '/' + userId : '' %>?date=<%= encodeURIComponent(available_dates[key]) %>" class="block text-center py-3 bg-green-100 text-green-700 font-semibold rounded-md hover:bg-green-200 transition-colors">
                                <%= available_dates[key] %>
                            </a>
                        <% } %>
                    </div>
                    
                </div>
            <% } else { %>
                <p class="text-red-600 text-lg mb-4 text-center"><%= message %></p>
            <% } %>

            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">Get available dates (GET) API Endpoint:</p>
                <code class="bg-gray-100 px-3 py-2 rounded-md inline-block text-blue-700">
                    <%= baseUrl %>/get-available-dates?type=json
                </code>
            </div>
            <!-- Optional footer -->
            <div class="mt-8 text-center text-sm text-gray-500">
                <p>&copy; 2025 Your Hospital. All rights reserved.</p>
            </div>
            <p>Click on any date to add/delete slots</p>
        </div>
    </div>
</body>
</html>
