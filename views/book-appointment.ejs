<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Appointment</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans text-gray-800">

    <div class="min-h-screen relative flex items-center justify-center">
        <% if (success_msg && success_msg.length > 0) { %>
            <div id="flash-success" class="fixed top-4 left-1/2 transform -translate-x-1/2 bg-green-100 text-green-800 px-6 py-3 rounded-lg shadow-md z-50">
              <%= success_msg %>
            </div>
          <% } %>
          
          <% if (error_msg && error_msg.length > 0) { %>
            <div id="flash-error" class="fixed top-4 left-1/2 transform -translate-x-1/2 bg-red-100 text-red-800 px-6 py-3 rounded-lg shadow-md z-50">
              <%= error_msg %>
            </div>
          <% } %>
          
          <% if (info_msg && info_msg.length > 0) { %>
            <div id="flash-info" class="fixed top-4 left-1/2 transform -translate-x-1/2 bg-blue-100 text-blue-800 px-6 py-3 rounded-lg shadow-md z-50">
              <%= info_msg %>
            </div>
          <% } %>
          
        
        <!-- Go to Home Page Button on Top-Right -->
        <div class="absolute top-6 right-6">
            <a href="/" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors">
                Go to Home Page
            </a>
        </div>
        
        <div class="max-w-2xl w-full p-8 bg-white shadow-xl rounded-xl mt-10 border-t-4 border-blue-600">
            <h1 class="text-3xl font-semibold text-center text-blue-700 mb-6">
                <%= isReschedule ? "Reschedule Appointment" : "Book Appointment" %>
            </h1>
            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">Book Appointment (POST) API Endpoint:</p>
                <code class="bg-gray-100 px-3 py-2 rounded-md inline-block text-blue-700">
                    <% if (isReschedule) { %>
                        <%= baseUrl %>/reschedule-appointment/:mobileNo?type=json
                    <% } else { %>
                        <%= baseUrl %>/book-appointment/<%= userId %>?type=json
                    <% } %>
                </code>
            </div>
            <!-- Form to Select Date and Time Slot -->
            <form action="<%= isReschedule ? '/reschedule-appointment/'+booking.mobile : '/book-appointment' %>" method="POST" class="space-y-6">

                <input type="hidden" name="userId" value="<%= userId %>">
                <!-- Name Field -->
                <div>
                    <label for="name" class="block text-lg font-medium text-gray-700">Name</label>
                    <input 
                        type="text" 
                        id="name" 
                        name="name" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                        placeholder="Enter your name (optional)"
                        value="<%= isReschedule ? booking.name : '' %>">
                </div>

                <!-- Mobile Field -->
                <div>
                    <label for="mobile" class="block text-lg font-medium text-gray-700">Mobile</label>
                    <input 
                        type="tel" 
                        id="mobile" 
                        name="mobile" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                        placeholder="Enter your mobile number (optional)"
                        value="<%= isReschedule ? booking.mobile : '' %>">
                </div>

                <!-- Title Field -->
                <div>
                    <label for="title" class="block text-lg font-medium text-gray-700">Title</label>
                    <input 
                        type="text" 
                        id="title" 
                        name="title" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                        placeholder="Enter your title (optional)"
                        value="<%= isReschedule ? booking.title : '' %>">
                </div>

                <!-- Email Field -->
                <div>
                    <label for="email" class="block text-lg font-medium text-gray-700">Email</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                        placeholder="Enter your email (optional)"
                        value="<%= isReschedule ? booking.email : '' %>">
                </div>

                <!-- Doctor Dropdown -->
                <div>
                    <label for="doctor" class="block text-lg font-medium text-gray-700">Select a Doctor</label>
                    <select 
                      id="doctor" 
                      name="doctor" 
                      class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      required>
                      <option value="" disabled selected>Choose a doctor</option>
                  
                      <% doctors.forEach(doc => { %>
                        <option value="<%= doc._id %>" <%= isReschedule && booking.doctor == doc._id ? 'selected' : '' %>><%= doc.name %></option>
                      <% }) %>
                    </select>
                  </div>
                  

                <!-- Select Date -->
                <div>
                    <label for="date" class="block text-lg font-medium text-gray-700">Select a Date</label>
                    <select 
                        id="date" 
                        name="date" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                        required 
                        onchange="updateTimeSlots()"
                        value="<%= isReschedule ? booking.date : '' %>">
                        <option value="" disabled selected>Choose a date</option>
                
                        <!-- Dynamically render available dates -->
                        <% Object.values(available_dates).forEach(date => { %>
                            <option value="<%= date %>" <%= isReschedule && booking.date === date ? 'selected' : '' %>><%= date %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Select Time Slot -->
                <div>
                    <label for="timeSlot" class="block text-lg font-medium text-gray-700">Select a Time Slot</label>
                    <select 
                        id="timeSlot"  
                        name="timeSlot" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                        required
                        value="<%= isReschedule ? booking.timeSlot : '' %>">
                        <option value="" disabled selected>Choose a time slot</option>
                        <!-- Time slots will be dynamically updated based on selected date -->
                    </select>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button 
                        type="submit" 
                        class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        <%= isReschedule ? "Reschedule Appointment" : "Book Appointment" %>
                    </button>
                </div>
            </form>

            <!-- Razorpay Payment Section -->
            <div class="text-center mt-8">
                <p class="text-lg font-medium text-gray-700 mb-4">Pay for Your Appointment</p>
                <form id="payment-form">
                    <input type="hidden" id="appointment-amount" value="100">
                    <button type="button" id="pay-btn" class="px-6 py-3 bg-green-600 text-white font-semibold rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                        Pay Now
                    </button>
                </form>
            </div>

            <div class="text-center mt-8">
                <p class="text-sm text-gray-500">&copy; 2025 Your Hospital. All rights reserved.</p>
            </div>
        </div>
    </div>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        // Fetch available time slots dynamically based on selected date
        const availableTimeSlotsByDate = <%- JSON.stringify(available_time_slots_by_date) %>;

        function updateTimeSlots() {
            const selectedDate = document.getElementById('date').value;
            const timeSlotDropdown = document.getElementById('timeSlot');
            timeSlotDropdown.innerHTML = '<option value="" disabled selected>Choose a time slot</option>'; // Reset dropdown

            // Filter time slots based on the selected date
            const availableSlots = availableTimeSlotsByDate[selectedDate] || [];

            // Populate the dropdown with available slots
            availableSlots.forEach(slot => {
                const option = document.createElement('option');
                option.value = `${slot.startTime} - ${slot.endTime}`;
                option.textContent = `${slot.startTime} - ${slot.endTime}`;
                timeSlotDropdown.appendChild(option);
            });
        }

        document.getElementById("pay-btn").addEventListener("click", async () => {
            // Collect form data
            const name = document.getElementById("name").value;
            const mobile = document.getElementById("mobile").value;
            const title = document.getElementById("title").value;
            const email = document.getElementById("email").value;
            const date = document.getElementById("date").value;
            const timeSlot = document.getElementById("timeSlot").value;
            const amount = document.getElementById("appointment-amount").value;

            // Construct the query parameters string
            const queryParams = new URLSearchParams({
                name,
                mobile,
                title,
                email,
                date,
                timeSlot
            }).toString();

            // Update the URL without reloading the page
            window.history.pushState({}, '', window.location.pathname + '?' + queryParams);

            // Request the backend to create the Razorpay order
            const response = await fetch("/create-order", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    amount: amount, // Pass the appointment amount
                    currency: "INR",
                }),
            });

            const order = await response.json();

            // Initialize Razorpay Checkout with order details
            const options = {
                key: "rzp_live_0MtOlXlnQqezZd", // Your Razorpay key_id
                amount: order.amount,
                currency: order.currency,
                name: "Hospital Appointment",
                description: "Payment for appointment",
                order_id: order.id,
                prefill: {
                    name: name,  // User's Name from form
                    email: email, // User's Email from form
                    contact: mobile
                },
                handler: function (response) {
                    // On successful payment
                    alert("Payment Successful!");

                    // Include form data and payment details when saving the booking
                    const paymentDetails = {
                        paymentId: response.razorpay_payment_id,
                        orderId: response.razorpay_order_id,
                        signature: response.razorpay_signature,
                        name,
                        mobile,
                        title,
                        email,
                        date,
                        timeSlot
                    };

                    // Save the payment details and update the appointment (backend)
                    fetch("/save-payment?" + queryParams, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(paymentDetails),
                    });
                },
                theme: {
                    color: "#3399cc",
                },
            };

            const razorpay = new Razorpay(options);
            razorpay.open();
        });

        // Function to get query parameters
function getQueryParams() {
    const params = new URLSearchParams(window.location.search);
    return {
        name: params.get("name") || "",
        mobile: params.get("mobile") || "",
        title: params.get("title") || "",
        email: params.get("email") || "",
        date: params.get("date") || "",
        timeSlot: params.get("timeSlot") || ""
    };
}

// Function to prefill form fields
// function prefillForm() {
//     const data = getQueryParams();
//     document.getElementById("name").value = data.name;
//     document.getElementById("mobile").value = data.mobile;
//     document.getElementById("title").value = data.title;
//     document.getElementById("email").value = data.email;
//     document.getElementById("date").value = data.date;
//     document.getElementById("timeSlot").value = data.timeSlot;
// }


function prefillForm() {
    const data = getQueryParams();
    document.getElementById("name").value = data.name;
    document.getElementById("mobile").value = data.mobile;
    document.getElementById("title").value = data.title;
    document.getElementById("email").value = data.email;
    document.getElementById("date").value = data.date;

    // Wait for time slots to load, then select the correct one
    setTimeout(() => {
        updateTimeSlots(); // Ensure time slots are loaded first
        const timeSlotDropdown = document.getElementById("timeSlot");
        if (data.timeSlot) {
            [...timeSlotDropdown.options].forEach(option => {
                if (option.value === data.timeSlot) {
                    option.selected = true;
                }
            });
        }
    }, 300); // Delay to allow updateTimeSlots() to populate options
}

// Prefill the form on page load
window.onload = prefillForm;


  // Fade out flash messages after 3 seconds
  setTimeout(() => {
    const success = document.getElementById('flash-success');
    const error = document.getElementById('flash-error');
    const info = document.getElementById('flash-info');

    [success, error, info].forEach(el => {
      if (el) {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 500); // remove after fade out
      }
    });
  }, 3000);

    </script>
</body>
</html>
